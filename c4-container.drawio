          <mxGeometry x="360" y="560" width="220" height="200" as="geometry" />
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Kafka 4]&lt;/div&gt;&lt;br&gt;&lt;div&gt;sms.vip — 16 partitions&lt;br&gt;sms.normal — 16 partitions&lt;br&gt;sms.accounting.compensation — 4&lt;br&gt;&lt;br&gt;فرمول: max(ceil(10k/625), WhaleSalt=16)&lt;/div&gt;" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fontSize=12;fontColor=#ffffff;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#0E7DAD;align=center;verticalAlign=bottom;fontFamily=Helvetica;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];rounded=0;" vertex="1" parent="1">
