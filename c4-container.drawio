        <!-- Title -->
        <mxCell id="title" value="C4 — Container Diagram · SMS Gateway Arvan" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="بر اساس mind_map.drawio و کد فعلی (cmd/api + cmd/report). ورکرهای Telecom / Accounting / Compensation / HoldSweeper داخل کانتینر API Process هستند." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1900" height="28" as="geometry" />
        </mxCell>

        <!-- Person: Customer -->
        <mxCell id="customer" value="&lt;b&gt;Customer&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;سامانه یا کاربر بالادستی&lt;br&gt;ارسال پیام و دریافت گزارش" style="shape=mxgraph.c4.person;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;labelBackgroundColor=none;fillColor=#083F75;strokeColor=#06315C;align=center;fontFamily=Helvetica;metaEdit=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="180" height="180" as="geometry" />
        </mxCell>

        <!-- System boundary -->
        <mxCell id="boundary" value="SMS Gateway&lt;div&gt;[Software System]&lt;/div&gt;" style="shape=mxgraph.c4.systemBoundary;html=1;whiteSpace=wrap;fontSize=14;fontColor=#666666;labelBackgroundColor=none;align=left;verticalAlign=bottom;dashed=1;dashPattern=8 4;strokeColor=#666666;fontFamily=Helvetica;fontStyle=1;metaEdit=1;perimeter=rectanglePerimeter;boundingBox=1;container=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="1180" height="900" as="geometry" />
        </mxCell>

        <!-- API Process -->
        <mxCell id="api" value="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;API Process&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go · Gin · Kafka client]&lt;/div&gt;&lt;br&gt;&lt;div&gt;cmd/api · پورت 9095&lt;br&gt;POST /api/v1/sms/vip&lt;br&gt;POST /api/v1/sms/normal&lt;br&gt;&lt;br&gt;idempotency → Reserve Redis →&lt;br&gt;Produce Kafka → Store 202&lt;br&gt;&lt;br&gt;&lt;b&gt;Workers داخل همین پروسه:&lt;/b&gt;&lt;br&gt;• Telecom (90ms/50ms backpressure)&lt;br&gt;• Accounting (batch outbox)&lt;br&gt;• Compensation (Saga)&lt;br&gt;• Hold Sweeper&lt;/div&gt;" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fontSize=12;fontColor=#ffffff;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#0E7DAD;align=center;verticalAlign=bottom;fontFamily=Helvetica;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];rounded=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="320" height="320" as="geometry" />
        </mxCell>

        <!-- Report Process -->
        <mxCell id="report" value="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;Report Process&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Go · Gin · clickhouse-go]&lt;/div&gt;&lt;br&gt;&lt;div&gt;cmd/report · پورت 9096&lt;br&gt;جدا از api تا اسکن سنگین&lt;br&gt;مسیر ارسال را نبندد&lt;br&gt;&lt;br&gt;GET .../report/messages&lt;br&gt;GET .../report/summary&lt;br&gt;&lt;br&gt;فقط خواندن ClickHouse&lt;/div&gt;" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fontSize=12;fontColor=#ffffff;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#0E7DAD;align=center;verticalAlign=bottom;fontFamily=Helvetica;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];rounded=0;" vertex="1" parent="1">
