#!/usr/bin/env bash
# دادهٔ ماک برای تست APIها (همان tenant برونو)
#
# کاربر:
#   tenant_id = 11111111-1111-1111-1111-111111111111
#   موجودی Postgres / Redis = 1000
#
# پیش‌نیاز: جداول migration ساخته شده باشند.
# اجرا:
#   ./mock
#   یا با پورت داکر کامپوز:
#   POSTGRES_DSN='postgres://postgres:1234@127.0.0.1:5433/sms_gateway?sslmode=disable' \
#   CLICKHOUSE_HOST=127.0.0.1 REDIS_PORT=6380 ./mock

set -euo pipefail

TENANT="11111111-1111-1111-1111-111111111111"
BALANCE=1000

POSTGRES_DSN="${POSTGRES_DSN:-postgres://postgres:1234@127.0.0.1:5432/sms_gateway?sslmode=disable}"
CLICKHOUSE_HOST="${CLICKHOUSE_HOST:-127.0.0.1}"
CLICKHOUSE_PORT="${CLICKHOUSE_PORT:-9000}"
CLICKHOUSE_USER="${CLICKHOUSE_USER:-default}"
CLICKHOUSE_PASSWORD="${CLICKHOUSE_PASSWORD:-clickhouse}"
REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
REDIS_PORT="${REDIS_PORT:-6379}"

echo "==> postgres wallet ($TENANT)"
psql "$POSTGRES_DSN" -v ON_ERROR_STOP=1 <<SQL
INSERT INTO wallet (customer_id, available_balance)
VALUES ('$TENANT', $BALANCE)
ON CONFLICT (customer_id) DO UPDATE
SET available_balance = EXCLUDED.available_balance,
    updated_at = now();
SQL

echo "==> redis wallet"
redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" \
  HSET "wallet:$TENANT" available "$BALANCE" reserved 0 >/dev/null

echo "==> clickhouse sms_messages"
clickhouse-client \
  --host "$CLICKHOUSE_HOST" \
  --port "$CLICKHOUSE_PORT" \
  --user "$CLICKHOUSE_USER" \
  --password "$CLICKHOUSE_PASSWORD" \
  --multiquery <<'SQL'
DELETE FROM sms.sms_messages
WHERE tenant_id = '11111111-1111-1111-1111-111111111111'
  AND startsWith(idempotency_key, 'mock-');

INSERT INTO sms.sms_messages
(
    tenant_id, id, customer_id, idempotency_key, kind, recipient, sender, body,
    cost, event_type, deadline_at, created_at
)
VALUES
(
    '11111111-1111-1111-1111-111111111111',
    'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa1',
    '11111111-1111-1111-1111-111111111111',
    'mock-otp-accepted-001',
    'otp',
    '09121111111',
    '1000',
    'code 1111',
    1,
    'message.accepted',
    now64(3) + toIntervalSecond(30),
    now64(3) - toIntervalHour(1)
),
(
    '11111111-1111-1111-1111-111111111111',
    'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa2',
    '11111111-1111-1111-1111-111111111111',
    'mock-otp-refunded-001',
    'otp',
    '09122222222',
    '1000',
    'code 2222',
    1,
    'message.refunded',
    now64(3) + toIntervalSecond(30),
    now64(3) - toIntervalHour(2)
),
(
    '11111111-1111-1111-1111-111111111111',
    'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa3',
    '11111111-1111-1111-1111-111111111111',
    'mock-normal-accepted-001',
    'normal',
    '09123333333',
    '2000',
    'hello mock',
    1,
    'message.accepted',
    NULL,
    now64(3) - toIntervalHour(3)
),
(
    '11111111-1111-1111-1111-111111111111',
    'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa4',
    '11111111-1111-1111-1111-111111111111',
    'mock-normal-rejected-001',
    'normal',
    '09124444444',
    '2000',
    'rejected mock',
    1,
    'message.rejected',
    NULL,
    now64(3) - toIntervalHour(4)
),
(
    '11111111-1111-1111-1111-111111111111',
    'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa5',
    '11111111-1111-1111-1111-111111111111',
    'mock-normal-accepted-002',
    'normal',
    '09125555555',
    '2000',
    'second accepted',
    1,
    'message.accepted',
    NULL,
    now64(3) - toIntervalMinute(30)
);
SQL

echo "mock ready"
echo "  tenant_id = $TENANT"
echo "  wallet    = $BALANCE (postgres + redis)"
echo "  report    = 5 rows in sms.sms_messages (accepted×3, refunded×1, rejected×1)"
echo "  bruno     = environment variable tenantId already matches this user"
